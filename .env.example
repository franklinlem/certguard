# Copie para .env e escolha uma senha forte. Não commite o arquivo real.
POSTGRES_PASSWORD=
APP_ENV=development
PUBLIC_APP_URL=http://localhost:8088

# Habilite somente após cadastrar destinos autorizados.
SCHEDULER_ENABLED=false
CHECK_WORKERS=10
CHECK_TIMEOUT=10s
# Exclusão definitiva: revise janela e backup antes de habilitar.
RETENTION_ENABLED=false
RETENTION_DAYS=180
RETENTION_BATCH=500
